{
  "name": "opencode-usage-tui",
  "version": "0.5.0",
  "description": "Persistent OpenRouter credits widget for OpenCode configurable refresh/endpoint/low-threshold/auth-path, low-credit notifications.",
  "type": "module",
  "license": "MIT",
  "author": "theQuantumMechanic",
  "repository": {
    "type": "git",
    "url": "https://github.com/albert118/opencode-usage-tui.git"
  },
  "homepage": "https://github.com/albert118/opencode-usage-tui",
  "bugs": {
    "url": "https://github.com/albert118/opencode-usage-tui/issues"
  },
  "keywords": [
    "opencode",
    "opentui",
    "openrouter",
    "credits",
    "tui",
    "plugin",
    "usage"
  ],
  "exports": {
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js",
      "default": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "typecheck": "tsc --emitDeclarationOnly",
    "test": "bun test",
    "clean": "bun run clean.ts",
    "prepublishOnly": "bun run clean && bun run typecheck && bun run build && bun test"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.0",
    "@opentui/solid": ">=0.5.11",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.0.20",
    "@opencode/theme": "2.0.20",
    "@opentui/core": "0.5.12",
    "@opentui/solid": "0.5.12",
    "solid-js": "1.9.12",
    "typescript": "^5.9.3",
    "@types/bun": "^1.4.2"
  }
}